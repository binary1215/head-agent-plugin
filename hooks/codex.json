{
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|clear|compact|fork",
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/session-host-hook.mjs\" --runtime codex",
        "timeout": 10,
        "additionalContextLimit": 4096
      }]
    }]
  }
}
